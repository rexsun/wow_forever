# Track Interface and custom YUI fonts; the client, cache, logs and WTF settings stay out.
/*
!/.gitignore
!/readme.md
!/Interface/
!/Fonts/
/Fonts/*
!/Fonts/YUIInterBlack.ttf
!/Fonts/YUIInterBold.ttf
!/Fonts/YUIText.ttf
!/Fonts/YUILongZhu.ttf
!/Fonts/YUIHOOGE.ttf
!/Fonts/YUIDamage1.ttf
!/Fonts/YUIDark.ttf

Thumbs.db
desktop.ini

*.local*
*_local_*
addon-backups/

__pycache__/
*.pyc

/Interface/.env*
!/Interface/.env.example
