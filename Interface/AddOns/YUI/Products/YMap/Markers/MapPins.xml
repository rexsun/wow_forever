<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <Button name="YUIMapMarkersQuickFilterButtonTemplate" frameStrata="HIGH" mixin="YUIMapMarkersQuickFilterButtonMixin" hidden="true" virtual="true">
        <Size x="32" y="32"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background" file="Interface\Minimap\UI-Minimap-Background">
                    <Size x="25" y="25"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" x="2" y="-4"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="Icon" atlas="poi-islands-table">
                    <Size x="18" y="18"/>
                    <Anchors>
                        <Anchor point="CENTER" x="0" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY" textureSubLevel="1">
                <Texture parentKey="Border" file="Interface\Minimap\MiniMap-TrackingBorder">
                    <Size x="54" y="54"/>
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <HighlightTexture alphaMode="ADD" file="Interface\Minimap\UI-Minimap-ZoomButton-Highlight"/>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnClick method="OnClick"/>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
        </Scripts>
    </Button>

    <Frame name="YUIMapMarkersPinTemplate" mixin="YUIMapMarkersPinMixin" hidden="true" enableMouseMotion="true" enableMouseClicks="true" passThroughButtons="RightButton" virtual="true">
        <Size x="48" y="18"/>
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Label" inherits="GameFontNormalSmall" justifyH="CENTER" wordWrap="true">
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>
</Ui>
