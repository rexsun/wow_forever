<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/..\FrameXML\UI.xsd">

	<!-- Foundation: must be first, everything uses LibStub -->
	<Script file="LibStub\LibStub.lua"/>

	<!-- CallbackHandler: required by AceAddon and AceEvent -->
	<Include file="CallbackHandler-1.0\CallbackHandler-1.0.xml"/>

	<!-- Ace3 core -->
	<Include file="AceAddon-3.0\AceAddon-3.0.xml"/>
	<Include file="AceEvent-3.0\AceEvent-3.0.xml"/>
	<Include file="AceTimer-3.0\AceTimer-3.0.xml"/>
	<Include file="AceConsole-3.0\AceConsole-3.0.xml"/>
	<Include file="AceComm-3.0\AceComm-3.0.xml"/>

	<!-- Ace3 saved variables, GUI, and options -->
	<Include file="AceDB-3.0\AceDB-3.0.xml"/>
	<Include file="AceGUI-3.0\AceGUI-3.0.xml"/>
	<Include file="AceConfig-3.0\AceConfig-3.0.xml"/>
	<Include file="AceDBOptions-3.0\AceDBOptions-3.0.xml"/>

	<!-- Shared media (fonts, textures, sounds): required by DetailsFramework/fw.lua -->
	<Include file="LibSharedMedia-3.0\lib.xml"/>

	<!-- Data broker and minimap icon -->
	<Script file="LibDataBroker-1.1\LibDataBroker-1.1.lua"/>
	<Script file="LibDBIcon-1.0\LibDBIcon-1.0.lua"/>

	<!-- LibEditMode: edit mode integration for repositioning addon frames -->
	<Include file="LibEditMode\embed.xml"/>

	<!-- LibCustomGlow: marching ants / autocast / pixel-line glow styles -->
	<Include file="LibCustomGlow-1.0\LibCustomGlow-1.0.xml"/>

	<!-- LibAuraContainer: Blizzard's CustomAuraContainer on retail (passed through untouched), an emulation on classic -->
	<Include file="LibAuraContainer-1.0\LibAuraContainer.xml"/>

	<!-- DetailsFramework: last, depends on all libraries above -->
	<Include file="DetailsFramework\load.xml"/>

</Ui>
