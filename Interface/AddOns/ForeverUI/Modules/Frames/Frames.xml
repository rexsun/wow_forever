<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ UI.xsd">

  <!--
    Look and behaviour shared by the real party frames and the /hf unlock preview.

    Everything a secure button needs at creation (size, click registration) is
    declared here rather than set from Lua. The group header can create a button
    in the middle of combat when someone joins, and a Lua SetSize or
    RegisterForClicks on a protected frame at that moment would be blocked.
    Keep the size in sync with BUTTON_WIDTH / BUTTON_HEIGHT in ForeverUIFrames.lua.
  -->
  <!-- Small outlined numbers for HoT countdowns. -->
  <Font name="ForeverUIFramesTinyFont" font="Fonts\FRIZQT__.TTF" outline="NORMAL" virtual="true">
    <FontHeight val="9"/>
  </Font>

  <Button name="ForeverUIFramesUnitButtonBaseTemplate" virtual="true" registerForClicks="AnyUp">
    <Size x="120" y="36"/>
    <Layers>
      <Layer level="BACKGROUND">
        <!-- Shows as a 1px edge around the inset health bar: black, or the
             debuff colour when there's something you can dispel. -->
        <Texture parentKey="edge" setAllPoints="true">
          <Color r="0" g="0" b="0" a="1"/>
        </Texture>
      </Layer>
    </Layers>
    <Frames>
      <StatusBar parentKey="power" minValue="0" maxValue="1" defaultValue="1" hidden="true">
        <Anchors>
          <Anchor point="BOTTOMLEFT" x="1" y="1"/>
          <Anchor point="BOTTOMRIGHT" x="-1" y="1"/>
        </Anchors>
        <Size y="4"/>
        <Layers>
          <Layer level="BACKGROUND">
            <Texture setAllPoints="true">
              <Color r="0.08" g="0.08" b="0.08" a="1"/>
            </Texture>
          </Layer>
        </Layers>
        <BarTexture file="Interface\TargetingFrame\UI-StatusBar"/>
      </StatusBar>
      <StatusBar parentKey="health" minValue="0" maxValue="1" defaultValue="1">
        <Anchors>
          <Anchor point="TOPLEFT" x="1" y="-1"/>
          <Anchor point="BOTTOMRIGHT" x="-1" y="1"/>
        </Anchors>
        <Layers>
          <Layer level="BACKGROUND">
            <!-- The missing-health part of the bar; its colour is a setting. -->
            <Texture parentKey="bg" setAllPoints="true">
              <Color r="0.12" g="0.12" b="0.12" a="1"/>
            </Texture>
          </Layer>
          <Layer level="ARTWORK" textureSubLevel="1">
            <!-- Incoming heals, laid past the end of the fill by Indicators.lua:
                 yours bright, other healers' darker. -->
            <Texture parentKey="incomingMine" hidden="true">
              <Color r="0.35" g="1" b="0.45" a="0.75"/>
            </Texture>
            <Texture parentKey="incomingOthers" hidden="true">
              <Color r="0.1" g="0.55" b="0.25" a="0.75"/>
            </Texture>
          </Layer>
          <Layer level="OVERLAY" textureSubLevel="-8">
            <Texture parentKey="hover" setAllPoints="true" alphaMode="ADD" hidden="true">
              <Color r="1" g="1" b="1" a="0.15"/>
            </Texture>
          </Layer>
          <Layer level="OVERLAY" textureSubLevel="-7">
            <Texture parentKey="dispelTint" setAllPoints="true" hidden="true"/>
          </Layer>
          <Layer level="OVERLAY" textureSubLevel="1">
            <Texture parentKey="dispelIcon" hidden="true">
              <Size x="12" y="12"/>
              <Anchors>
                <Anchor point="TOPRIGHT" x="-2" y="-2"/>
              </Anchors>
              <TexCoords left="0.08" right="0.92" top="0.08" bottom="0.92"/>
            </Texture>
          </Layer>
          <Layer level="OVERLAY">
            <!-- Top row: name, dispel icon. Bottom row: HoTs, health text. -->
            <FontString parentKey="name" inherits="GameFontHighlightSmall" justifyH="LEFT" wordwrap="false">
              <Anchors>
                <Anchor point="TOPLEFT" x="4" y="-4"/>
                <Anchor point="TOPRIGHT" x="-18" y="-4"/>
              </Anchors>
            </FontString>
            <!-- Grid style: name across the top, big percentage in the middle. -->
            <FontString parentKey="big" inherits="GameFontNormalLarge" justifyH="CENTER" hidden="true">
              <Anchors><Anchor point="CENTER" x="0" y="-1"/></Anchors>
            </FontString>
            <!-- Tank / healer / damage marker, top-left. -->
            <FontString parentKey="role" inherits="ForeverUIFramesTinyFont" justifyH="LEFT" hidden="true">
              <Size x="12" y="12"/>
              <Anchors><Anchor point="TOPLEFT" x="3" y="-2"/></Anchors>
            </FontString>
            <FontString parentKey="status" inherits="GameFontHighlightSmall" justifyH="RIGHT">
              <Anchors>
                <Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
              </Anchors>
              <Color r="1" g="0.5" b="0.5"/>
            </FontString>
          </Layer>
        </Layers>
        <BarTexture file="Interface\TargetingFrame\UI-StatusBar"/>
        <Frames>
          <!-- Four corner slots for the spells you choose to watch (Auras page).
               Each slot shows an icon or a plain colour, with a countdown and
               a stack count. -->
          <Frame parentKey="watch" setAllPoints="true">
            <Layers>
              <Layer level="ARTWORK" textureSubLevel="2">
                <Texture parentArray="icons" hidden="true">
                  <Size x="13" y="13"/>
                  <Anchors><Anchor point="TOPLEFT" x="2" y="-2"/></Anchors>
                  <TexCoords left="0.08" right="0.92" top="0.08" bottom="0.92"/>
                </Texture>
                <Texture parentArray="icons" hidden="true">
                  <Size x="13" y="13"/>
                  <Anchors><Anchor point="TOPRIGHT" x="-2" y="-2"/></Anchors>
                  <TexCoords left="0.08" right="0.92" top="0.08" bottom="0.92"/>
                </Texture>
                <Texture parentArray="icons" hidden="true">
                  <Size x="13" y="13"/>
                  <Anchors><Anchor point="BOTTOMLEFT" x="2" y="2"/></Anchors>
                  <TexCoords left="0.08" right="0.92" top="0.08" bottom="0.92"/>
                </Texture>
                <Texture parentArray="icons" hidden="true">
                  <Size x="13" y="13"/>
                  <Anchors><Anchor point="BOTTOMRIGHT" x="-2" y="2"/></Anchors>
                  <TexCoords left="0.08" right="0.92" top="0.08" bottom="0.92"/>
                </Texture>
              </Layer>
              <Layer level="OVERLAY">
                <FontString parentArray="timers" inherits="ForeverUIFramesTinyFont" justifyH="CENTER" hidden="true">
                  <Size x="20" y="10"/>
                  <Anchors><Anchor point="TOPLEFT" x="2" y="-2"/></Anchors>
                </FontString>
                <FontString parentArray="timers" inherits="ForeverUIFramesTinyFont" justifyH="CENTER" hidden="true">
                  <Size x="20" y="10"/>
                  <Anchors><Anchor point="TOPRIGHT" x="-2" y="-2"/></Anchors>
                </FontString>
                <FontString parentArray="timers" inherits="ForeverUIFramesTinyFont" justifyH="CENTER" hidden="true">
                  <Size x="20" y="10"/>
                  <Anchors><Anchor point="BOTTOMLEFT" x="2" y="2"/></Anchors>
                </FontString>
                <FontString parentArray="timers" inherits="ForeverUIFramesTinyFont" justifyH="CENTER" hidden="true">
                  <Size x="20" y="10"/>
                  <Anchors><Anchor point="BOTTOMRIGHT" x="-2" y="2"/></Anchors>
                </FontString>
                <FontString parentArray="stacks" inherits="ForeverUIFramesTinyFont" justifyH="RIGHT" hidden="true">
                  <Size x="13" y="10"/>
                  <Anchors><Anchor point="TOPLEFT" x="2" y="-11"/></Anchors>
                </FontString>
                <FontString parentArray="stacks" inherits="ForeverUIFramesTinyFont" justifyH="RIGHT" hidden="true">
                  <Size x="13" y="10"/>
                  <Anchors><Anchor point="TOPRIGHT" x="-2" y="-11"/></Anchors>
                </FontString>
                <FontString parentArray="stacks" inherits="ForeverUIFramesTinyFont" justifyH="RIGHT" hidden="true">
                  <Size x="13" y="10"/>
                  <Anchors><Anchor point="BOTTOMLEFT" x="2" y="11"/></Anchors>
                </FontString>
                <FontString parentArray="stacks" inherits="ForeverUIFramesTinyFont" justifyH="RIGHT" hidden="true">
                  <Size x="13" y="10"/>
                  <Anchors><Anchor point="BOTTOMRIGHT" x="-2" y="11"/></Anchors>
                </FontString>
              </Layer>
            </Layers>
          </Frame>
          <!-- Your HoTs and shields on this unit: up to 3 icons with countdowns.
               A child frame so the numbers always draw above the icons. -->
          <Frame parentKey="hots" setAllPoints="true">
            <Layers>
              <Layer level="ARTWORK">
                <Texture parentArray="icons" hidden="true">
                  <Size x="13" y="13"/>
                  <Anchors><Anchor point="BOTTOMLEFT" x="3" y="3"/></Anchors>
                  <TexCoords left="0.08" right="0.92" top="0.08" bottom="0.92"/>
                </Texture>
                <Texture parentArray="icons" hidden="true">
                  <Size x="13" y="13"/>
                  <Anchors><Anchor point="BOTTOMLEFT" x="17" y="3"/></Anchors>
                  <TexCoords left="0.08" right="0.92" top="0.08" bottom="0.92"/>
                </Texture>
                <Texture parentArray="icons" hidden="true">
                  <Size x="13" y="13"/>
                  <Anchors><Anchor point="BOTTOMLEFT" x="31" y="3"/></Anchors>
                  <TexCoords left="0.08" right="0.92" top="0.08" bottom="0.92"/>
                </Texture>
              </Layer>
              <Layer level="OVERLAY">
                <FontString parentArray="timers" inherits="ForeverUIFramesTinyFont" justifyH="CENTER" hidden="true">
                  <Size x="13" y="13"/>
                  <Anchors><Anchor point="BOTTOMLEFT" x="3" y="3"/></Anchors>
                </FontString>
                <FontString parentArray="timers" inherits="ForeverUIFramesTinyFont" justifyH="CENTER" hidden="true">
                  <Size x="13" y="13"/>
                  <Anchors><Anchor point="BOTTOMLEFT" x="17" y="3"/></Anchors>
                </FontString>
                <FontString parentArray="timers" inherits="ForeverUIFramesTinyFont" justifyH="CENTER" hidden="true">
                  <Size x="13" y="13"/>
                  <Anchors><Anchor point="BOTTOMLEFT" x="31" y="3"/></Anchors>
                </FontString>
              </Layer>
            </Layers>
          </Frame>
          <Frame parentKey="targetBorder" setAllPoints="true" hidden="true">
            <Layers>
              <Layer level="OVERLAY">
                <Texture>
                  <Size y="2"/>
                  <Anchors>
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="TOPRIGHT"/>
                  </Anchors>
                  <Color r="1" g="0.82" b="0"/>
                </Texture>
                <Texture>
                  <Size y="2"/>
                  <Anchors>
                    <Anchor point="BOTTOMLEFT"/>
                    <Anchor point="BOTTOMRIGHT"/>
                  </Anchors>
                  <Color r="1" g="0.82" b="0"/>
                </Texture>
                <Texture>
                  <Size x="2"/>
                  <Anchors>
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="BOTTOMLEFT"/>
                  </Anchors>
                  <Color r="1" g="0.82" b="0"/>
                </Texture>
                <Texture>
                  <Size x="2"/>
                  <Anchors>
                    <Anchor point="TOPRIGHT"/>
                    <Anchor point="BOTTOMRIGHT"/>
                  </Anchors>
                  <Color r="1" g="0.82" b="0"/>
                </Texture>
              </Layer>
            </Layers>
          </Frame>
        </Frames>
      </StatusBar>
    </Frames>
    <Scripts>
      <OnLoad>ForeverUIFrames.Button_OnLoad(self)</OnLoad>
      <OnAttributeChanged>ForeverUIFrames.Button_OnAttributeChanged(self, name, value)</OnAttributeChanged>
      <OnDragStart>ForeverUIFrames.StartMovingFrames()</OnDragStart>
      <OnDragStop>ForeverUIFrames.StopMovingFrames()</OnDragStop>
      <OnEnter>ForeverUIFrames.Button_OnEnter(self)</OnEnter>
      <OnLeave>ForeverUIFrames.Button_OnLeave(self)</OnLeave>
    </Scripts>
  </Button>

  <!-- What the group header actually creates: the base look plus secure clicks.
       What each click does is not set here: Bindings.lua hands the header the
       click-casting attributes, and the header copies them onto every button
       it creates, securely, even mid-combat. -->
  <Button name="ForeverUIFramesUnitButtonTemplate" virtual="true" inherits="SecureUnitButtonTemplate, ForeverUIFramesUnitButtonBaseTemplate"/>

</Ui>
