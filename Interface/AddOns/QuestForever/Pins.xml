<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <!-- One pin on the world map. The mixin (QuestForeverPinMixin, Pins.lua) is
       topped up from Blizzard's own map pin mixin when the map loads. -->
  <Frame name="QuestForeverPinTemplate" mixin="QuestForeverPinMixin" enableMouse="true" virtual="true">
    <Size x="16" y="16"/>
    <Layers>
      <Layer level="OVERLAY">
        <Texture parentKey="Texture" setAllPoints="true"/>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad method="OnLoad"/>
    </Scripts>
  </Frame>
</Ui>
