# This example contains no real account/profile identifiers.
# The exporter fills Interface/.env with the stable aliases required by snapshots.
# Preserve the complete generated file; a few account names alone cannot decode snapshots.
WTF_MAP_VERSION=1

# Optional private location for locks, logs and restore backups.
# Single quotes preserve Windows backslashes literally.
# WTF_SETTINGS_STATE_DIR='D:\Private\WowSettings'

# Alias variable syntax (examples only; do not copy these over existing mappings):
# WTF_TEXT_0000001="settingName"
# WTF_NUMBER_0000001="0.85"
